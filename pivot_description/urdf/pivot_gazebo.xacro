<?xml version="1.0" encoding="UTF-8"?>

<robot name="pivot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==========================================================
       Wheel contact.
       mu 2.0 gives effectively no-slip without an absurd number.
       kp/kd chosen softer and better damped than a typical 4-contact
       AMR: this robot has only two contact points, and every contact
       impulse feeds straight into the pitch dynamics.
       ========================================================== -->

  <gazebo reference="left_wheel_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <!-- ==========================================================
       Chassis contact.
       Low friction so a fallen robot slides rather than catching
       and shuddering against the ground.
       ========================================================== -->

  <gazebo reference="base_link">
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

</robot>